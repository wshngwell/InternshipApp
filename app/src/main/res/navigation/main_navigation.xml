<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/postsFragment">

    <fragment
        android:id="@+id/postsFragment"
        android:name="com.example.internshipapp.presentation.postsInXML.posts.PostsFragment"
        android:label="fragment_posts"
        tools:layout="@layout/fragment_posts">
        <action
            android:id="@+id/action_postsFragment_to_postDetailsInfoFragment"
            app:destination="@id/postDetailsInfoFragment" />
    </fragment>
    <fragment
        android:id="@+id/postDetailsInfoFragment"
        android:name="com.example.internshipapp.presentation.postsInXML.comments.PostDetailsInfoFragment"
        android:label="PostDetailsInfoFragment">
        <argument
            android:name="postEntityJson"
            app:argType="string" />
    </fragment>
</navigation>