<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="10.dp">

        <TextView
            android:id="@+id/adTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@drawable/text_color"
            android:textSize="21.sp"
            android:textStyle="bold"
            tools:text="magnam facilis autem" />

        <TextView
            android:id="@+id/adMainText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.dp"
            android:textColor="@drawable/text_color"
            android:textSize="18sp"
            tools:text="magnam facilis autdsjgsj gdsklgjsdagha shgjsajgjahsghkasjgjsakghasgjjklasgjlsdgsdgsgjskjgsdgsgdgsdsgem" />

        <EditText
            android:id="@+id/addEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="new PostTitle"
            android:saveEnabled="false"
            android:textColor="@drawable/text_color"
            android:textColorHint="@drawable/text_color" />
    </LinearLayout>


</androidx.cardview.widget.CardView>